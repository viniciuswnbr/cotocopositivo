{
  "cleanUrls": true,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/episodio",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/episodio"
    },
    {
      "source": "/episodio.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/episodio"
    }
  ],
  "redirects": [
    {
      "source": "/yt",
      "destination": "/?utm_source=youtube&utm_medium=bio_desc",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/fb",
      "destination": "/?utm_source=facebook&utm_medium=post_bio",
      "permanent": false
    },
    {
      "source": "/podcast-ia",
      "destination": "/?utm_source=spotify_ia&utm_medium=podcast",
      "permanent": false
    },
    {
      "source": "/podcast-reflexoes",
      "destination": "/?utm_source=spotify_reflexoes&utm_medium=podcast",
      "permanent": false
    }
  ]
}
